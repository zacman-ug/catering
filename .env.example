# ─── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=5000

# PostgreSQL
DATABASE_URL=postgresql://postgres:12345@localhost:5432/chef_godwin

# JWT (for admin panel)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173

# Email (optional — for booking notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
BOOKING_NOTIFY_EMAIL=info@chefgodwin.ug

# File uploads
MAX_UPLOAD_SIZE_MB=5
